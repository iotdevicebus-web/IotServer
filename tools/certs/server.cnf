[ req ]
default_bits        = 2048
prompt              = no
default_md          = sha256
distinguished_name  = req_distinguished_name
req_extensions      = v3_req

[ req_distinguished_name ]
C  = JP
ST = Tokyo
L  = Chiyoda
O  = IoT Platform Project
OU = Server Operations
CN = 192.168.3.4


[ v3_req ]
basicConstraints     = CA:FALSE
keyUsage             = critical, digitalSignature, keyEncipherment
extendedKeyUsage     = serverAuth
subjectAltName       = @alt_names

[ alt_names ]
DNS.1 = localhost
DNS.2 = iot-server.local
DNS.3 = *.iot-server.local
DNS.4 = 192.168.3.4
IP.1  = 127.0.0.1
IP.2  = ::1
IP.3  = 192.168.3.4
IP.4  = 192.168.1.100
IP.5  = 192.168.0.100


