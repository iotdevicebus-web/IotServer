{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApiResponse",
  "description": "サーバからエッジデバイスへの共通レスポンススキーマ",
  "type": "object",
  "required": [
    "status",
    "server_time"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "OK",
        "ERROR",
        "INVALID_PAYLOAD",
        "UNAUTHORIZED"
      ]
    },
    "message": {
      "type": "string"
    },
    "server_time": {
      "type": "integer",
      "description": "サーバのUTC UNIXエポック秒 (エッジの時刻補正用)"
    },
    "sleep_interval_sec": {
      "type": "integer",
      "minimum": 1,
      "description": "次回送信までの推奨スリープ秒数 (サーバ側から動的制御可能)"
    },
    "ota": {
      "type": "object",
      "description": "利用可能なOTA更新情報 (更新が存在する場合のみ返却)",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "target_version": {
          "type": "string"
        },
        "package_url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer"
        },
        "mandatory": {
          "type": "boolean"
        }
      }
    },
    "commands": {
      "type": "array",
      "description": "デバイスに対する保留中の制御コマンド一覧",
      "items": {
        "type": "object",
        "required": [
          "command_id",
          "action"
        ],
        "properties": {
          "command_id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "REBOOT",
              "CONFIG_UPDATE",
              "SELF_TEST",
              "FACTORY_RESET"
            ]
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
